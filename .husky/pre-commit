echo "=== Running Frontend Linter ==="
npm run lint --prefix frontend || {
    echo "Frontend linting failed. Please fix the errors."
    exit 1
}

echo "=== Running Backend Linter ==="
npm run lint --prefix backend || {
    echo "Backend linting failed. Please fix the errors."
    exit 1
}

echo "=== Building Frontend ==="
npm run build --prefix frontend || {
    echo "Frontend build failed. Please fix the errors."
    exit 1
}

echo "=== Building Backend ==="
npm run build --prefix backend || {
    echo "Backend build failed. Please fix the errors."
    exit 1
}

echo "Linting and Builds passed!"
